					"name": "Lister les salles (OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Liste salles : statut 200', () => pm.response.to.have.status(200));",
									"const membres = pm.response.json().member;",
									"pm.test('Liste salles : au moins une salle', () => { pm.expect(membres).to.be.an('array'); pm.expect(membres.length).to.be.above(0); });",
									"const iri = (el) => String(el['@id']).split('/').pop();",
									"pm.environment.set('salleId', iri(membres[0]));",
									"pm.test('Liste salles : salleId sauvegarde', () => pm.expect(pm.environment.get('salleId')).to.be.a('string'));"
