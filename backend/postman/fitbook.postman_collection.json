                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login : statut 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Login : un token est renvoyé\", () => pm.expect(pm.response.json().token).to.be.a(\"string\"));\r\npm.environment.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
